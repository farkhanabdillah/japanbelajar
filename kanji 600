<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kartu kanji – 503 kata</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    --page: #e9edf3; --ink: #1b2440; --muted: #5b6482;
    --front: #1b2440; --front-ink: #f4f6fb; --front-soft: #aab3d1;
    --back: #ffffff; --back-ink: #1b2440; --line: #cdd4e4; --accent: #c8402f;
    --btn: #ffffff; --btn-ink: #1b2440; --seg-on: #1b2440; --seg-on-ink: #ffffff;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --page: #0f1424; --ink: #e8ebf6; --muted: #8f99bb;
      --front: #e8ebf6; --front-ink: #141a30; --front-soft: #55608a;
      --back: #1a2140; --back-ink: #e8ebf6; --line: #2c365e; --accent: #ff7a63;
      --btn: #1a2140; --btn-ink: #e8ebf6; --seg-on: #e8ebf6; --seg-on-ink: #141a30;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --page: #0f1424; --ink: #e8ebf6; --muted: #8f99bb;
    --front: #e8ebf6; --front-ink: #141a30; --front-soft: #55608a;
    --back: #1a2140; --back-ink: #e8ebf6; --line: #2c365e; --accent: #ff7a63;
    --btn: #1a2140; --btn-ink: #e8ebf6; --seg-on: #e8ebf6; --seg-on-ink: #141a30;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: inherit; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0; min-height: 100vh; background: var(--page); color: var(--ink);
    font-family: "Zen Kaku Gothic New", "Hiragino Sans", "Yu Gothic", "Noto Sans JP", system-ui, sans-serif;
    display: flex; flex-direction: column; align-items: center; padding: 20px 16px 28px;
  }
  header { width: 100%; max-width: 460px; display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
  h1 { font-size: 1rem; font-weight: 700; margin: 0; }
  #counter { font-size: .95rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  .setting { width: 100%; max-width: 460px; margin-bottom: 12px; }
  .setting-label { font-size: .8rem; color: var(--muted); margin-bottom: 6px; }
  .seg { display: flex; border: 1.5px solid var(--line); border-radius: 14px; padding: 3px; background: var(--btn); }
  .seg button {
    flex: 1; font: inherit; font-size: .9rem; font-weight: 500; padding: 10px 8px;
    border: 0; border-radius: 11px; background: transparent; color: var(--btn-ink); cursor: pointer;
  }
  .seg button[aria-checked="true"], .seg button[aria-pressed="true"] { background: var(--seg-on); color: var(--seg-on-ink); font-weight: 700; }
  .seg button:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }
  .groups { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; }
  .groups button { padding: 10px 2px; font-size: .82rem; font-variant-numeric: tabular-nums; }

  .stage { width: 100%; max-width: 460px; perspective: 1400px; }
  .card {
    position: relative; width: 100%; aspect-ratio: 3 / 4; min-height: 430px; max-height: 76vh;
    margin: 0 auto; cursor: pointer; transform-style: preserve-3d;
    transition: transform .55s cubic-bezier(.3,.7,.2,1);
    border: 0; background: none; padding: 0; display: block; text-align: inherit; font: inherit; color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .card.flipped { transform: rotateY(180deg); }
  .card:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; border-radius: 22px; }
  .face {
    position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    border-radius: 22px; display: flex; padding: 22px 20px; text-align: center; overflow: auto;
  }
  .inner { margin: auto; width: 100%; display: flex; flex-direction: column; align-items: center; }
  .front { background: var(--front); color: var(--front-ink); }
  .back  { background: var(--back); color: var(--back-ink); border: 1.5px solid var(--line); transform: rotateY(180deg); }

  .pic {
    width: clamp(110px, 34vw, 150px); aspect-ratio: 1; margin-bottom: 16px; padding: 10px;
    background: #f7f9fd; border-radius: 26px; box-shadow: inset 0 0 0 1.5px var(--line); flex: none;
    display: flex; align-items: center; justify-content: center; color: #7b86a8; overflow: hidden;
  }
  .pic.mini { width: 84px; margin: 0; padding: 7px; border-radius: 18px; }
  .pic svg { display: block; width: 100%; height: 100%; }
  .pic img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 16px; }
  .pic.empty { flex-direction: column; gap: 6px; font-size: .72rem; text-align: center; border: 2px dashed #b8c1da; box-shadow: none; }
  .pic.empty svg { width: 38%; height: auto; }
  .pic.mini.empty { font-size: 0; gap: 0; }
  .pic.mini.empty svg { width: 46%; }

  .serif { font-family: "Shippori Mincho", "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif; font-weight: 700; }
  .big { font-size: clamp(44px, 14vw, 80px); line-height: 1.15; letter-spacing: .04em; word-break: keep-all; }
  .big.long { font-size: clamp(32px, 10vw, 56px); }
  .big.kana { font-size: clamp(34px, 11vw, 58px); }
  .big.kana.long { font-size: clamp(26px, 8.2vw, 42px); }
  .hint { margin-top: 18px; font-size: .8rem; color: var(--front-soft); }

  .reading { font-size: clamp(30px, 9vw, 44px); color: var(--accent); margin-bottom: 10px; line-height: 1.2; }
  .meaning { font-size: clamp(1rem, 4.2vw, 1.2rem); line-height: 1.5; max-width: 32ch; }
  .row { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 16px 0 4px; flex-wrap: wrap; }
  .row .kanji { font-size: clamp(36px, 11vw, 54px); line-height: 1.1; color: var(--accent); word-break: keep-all; }
  .row .kanji.long { font-size: clamp(26px, 8vw, 38px); }

  .homo { margin-top: 14px; width: 100%; padding-top: 12px; border-top: 1.5px solid var(--line); }
  .homo-title { font-size: .78rem; color: var(--muted); margin-bottom: 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .chip { display: inline-flex; align-items: baseline; gap: 6px; border: 1.5px solid var(--line); border-radius: 12px; padding: 5px 10px; font-size: .82rem; }
  .chip .k { font-size: 1.1rem; }
  .none { font-size: .82rem; color: var(--muted); }

  .picbar { display: flex; gap: 8px; width: 100%; max-width: 460px; margin-top: 12px; }
  .picbar button {
    flex: 1; font: inherit; font-size: .85rem; padding: 10px 8px; border-radius: 12px; cursor: pointer;
    background: transparent; color: var(--ink); border: 1.5px dashed var(--line);
  }
  .picbar button:disabled { display: none; }
  .picbar button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  .controls { margin-top: 12px; display: flex; gap: 10px; width: 100%; max-width: 460px; }
  .controls button {
    flex: 1; font: inherit; font-weight: 500; font-size: 1rem; padding: 14px 10px; border-radius: 14px; cursor: pointer;
    background: var(--btn); color: var(--btn-ink); border: 1.5px solid var(--line);
  }
  .controls button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .controls button:active { transform: translateY(1px); }
  .controls button:disabled { opacity: .4; cursor: default; }
  .controls button[aria-pressed="true"] { background: var(--seg-on); color: var(--seg-on-ink); border-color: var(--seg-on); }
  #shuffle { flex: 0 0 auto; padding-inline: 18px; }

  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
</head>
<body>
  <header>
    <h1>Kartu flash kanji</h1>
    <span id="counter" aria-live="polite"></span>
  </header>

  <div class="setting">
    <div class="setting-label" id="group-label">Kelompok kata</div>
    <div class="seg groups" id="groups" role="group" aria-labelledby="group-label"></div>
  </div>

  <div class="setting">
    <div class="setting-label" id="mode-label">Depan kartu menampilkan</div>
    <div class="seg" role="radiogroup" aria-labelledby="mode-label">
      <button role="radio" id="m-kanji" aria-checked="true">Kanji + gambar</button>
      <button role="radio" id="m-yomi" aria-checked="false">Bacaan + gambar</button>
    </div>
  </div>

  <div class="stage">
    <button class="card" id="card" aria-label="Kartu flash. Tekan untuk membalik.">
      <div class="face front"><div class="inner" id="front"></div></div>
      <div class="face back"><div class="inner" id="back"></div></div>
    </button>
  </div>

  <div class="picbar">
    <button id="addpic">Tambah gambar</button>
    <button id="delpic" disabled>Hapus gambar</button>
  </div>
  <input type="file" id="file" accept="image/*" hidden>

  <div class="controls">
    <button id="prev">Sebelumnya</button>
    <button id="shuffle" aria-pressed="false" title="Acak urutan dalam kelompok ini">Acak</button>
    <button id="next">Berikutnya</button>
  </div>

<script>
