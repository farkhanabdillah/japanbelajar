    var id = DATA[order[i]].id;
    var rd = new FileReader();
    rd.onload = function () {
      var img = new Image();
      img.onload = function () {
        var max = 320, sc = Math.min(1, max / Math.max(img.width, img.height));
        var cv = document.createElement("canvas");
        cv.width = Math.round(img.width * sc); cv.height = Math.round(img.height * sc);
        cv.getContext("2d").drawImage(img, 0, 0, cv.width, cv.height);
        putPic(id, cv.toDataURL("image/jpeg", 0.8));
        render();
      };
      img.src = rd.result;
    };
    rd.readAsDataURL(f);
  });

  card.addEventListener("click", function () { card.classList.toggle("flipped"); });
  document.getElementById("next").addEventListener("click", function () { go(1); });
  document.getElementById("prev").addEventListener("click", function () { go(-1); });
  document.getElementById("shuffle").addEventListener("click", toggleShuffle);
  document.getElementById("m-kanji").addEventListener("click", function () { setMode("kanji"); });
  document.getElementById("m-yomi").addEventListener("click", function () { setMode("yomi"); });
  document.addEventListener("keydown", function (e) {
    if (e.key === "ArrowRight") go(1);
    else if (e.key === "ArrowLeft") go(-1);
  });

  document.getElementById("shuffle").setAttribute("aria-pressed", shuffled ? "true" : "false");
  document.getElementById("m-kanji").setAttribute("aria-checked", mode === "kanji");
  document.getElementById("m-yomi").setAttribute("aria-checked", mode === "yomi");
  buildOrder();
  renderGroups();
  render();
  openDB(function () { render(); });
</script>
</body>
</html>
